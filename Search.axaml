<?xml version="1.0" encoding="UTF-8"?>
<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Width="400"
    Height="600"
    CanResize="False"
    x:Class="HoyoversePckPlayer.Search"
    Title="Search">
    <DockPanel Margin="7">
        <StackPanel Spacing="5">
            <StackPanel Orientation="Horizontal" Spacing="5">
                <TextBlock Margin="0 5 0 0">Search kind</TextBlock>
                <ComboBox SelectedIndex="0" Name="ComboBox">
                    <ComboBoxItem>
                        Full Name
                    </ComboBoxItem>
                    <ComboBoxItem>
                        File Name
                    </ComboBoxItem>
                    <ComboBoxItem>
                        BLAKE3 Hash
                    </ComboBoxItem>
                </ComboBox>
                <CheckBox Margin="0 5 0 0" Name="CheckBox">Case sensitive</CheckBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="5">
                <TextBox Watermark="Search" Width="300" Name="TextBox" />
                <Button Click="Button_OnClick">Search</Button>
            </StackPanel>
            <ListBox Name="ListBox" SelectionChanged="ListBox_OnSelectionChanged"/>
        </StackPanel>
    </DockPanel>
</Window>